.del-button{
    background-color:rgb(255, 255, 255);
    width: 20 px;
    height: 20 px;
    font-size: 10 px;
}
.text-field{
    flex-grow: 1;
    min-width: 0;
}
.main-container-line {
    background-color: rgb(230, 230, 230);
    margin: 5 px;
    padding: 5 px;
}
.name-container {
    background-color: rgb(94, 165, 73);
    width: 100 px;
    margin-bottom: 2 px;
    margin-top: 2 px;
    margin-left: 5 px;
    padding: 6 px;
    justify-content: center;
    flex-direction: row;
}
.text-container {
    background-color: rgb(128, 128, 128);
    margin-bottom: 2 px;
    margin-top: 2 px;
    margin-left: 5 px;
    padding: 6 px;
    justify-content: center;
}
.narrator-container {
    background-color: rgb(171, 255, 239);
    width: 100 px;
    margin-bottom: 2 px;
    margin-top: 2 px;
    margin-left: 5 px;
    padding: 2 px;
    flex-direction: row;
}
.char-container {
    background-color: rgb(255, 163, 248);
    margin-bottom: 2 px;
    margin-top: 2 px;
    margin-left: 5 px;
    padding: 2 px;
    flex-direction: row;
}
.bg-container {
    background-color: rgb(255, 184, 134);
    margin-bottom: 2 px;
    margin-top: 2 px;
    margin-left: 5 px;
    padding: 2 px;
    flex-direction: row;
}
.music-container {
    background-color: rgb(146, 157, 255);
    margin-bottom: 2 px;
    margin-top: 2 px;
    margin-left: 5 px;
    padding: 2 px;
    flex-direction: row;
}
.sound-container {
    background-color: rgb(234, 255, 128);
    margin-bottom: 2 px;
    margin-top: 2 px;
    margin-left: 5 px;
    padding: 2 px;
    flex-direction: row;
}
.variant-container {
    background-color: rgb(255, 140, 140);
    margin-bottom: 2 px;
    margin-top: 2 px;
    margin-left: 5 px;
    padding: 2 px;
    flex-direction: row;
}